# Required by the application in local development and each Vercel environment.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Local-only administrative and E2E tooling; never configure these in Vercel.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
E2E_OWNER_EMAIL=owner@example.com
E2E_OWNER_PASSWORD=REPLACE_WITH_OWNER_PASSWORD
